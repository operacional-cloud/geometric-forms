# ============================================================================
# Configuração local da Evolution API
# Copie pra .env (sem o .example) e edite valores marcados com TROCAR.
# ============================================================================

# API key que o Next.js vai usar pra autenticar requests pra Evolution API.
# Gere uma string aleatória forte (ex: openssl rand -hex 32 ou usa qualquer
# UUID). NUNCA compartilhe.
EVOLUTION_API_KEY=TROCAR-cole-aqui-uma-string-aleatoria-de-64-chars

# Senha do Postgres local (qualquer string, fica isolado dentro do Docker).
POSTGRES_PASSWORD=TROCAR-senha-forte-do-postgres

# URL pública do Evolution API.
# Quando rodando localmente, pode deixar em http://localhost:8080.
# Quando expor via Cloudflare Tunnel, troca pela URL pública que ele te der
# (ex: https://abc-xyz.trycloudflare.com).
EVOLUTION_PUBLIC_URL=http://localhost:8080

# URL do webhook que recebe eventos do WhatsApp.
# Aponta pra rota /api/whatsapp/webhook do seu deploy Vercel.
WEBHOOK_URL=https://geometric-forms.vercel.app/api/whatsapp/webhook

# Token Vercel — usado pelo start.ps1 pra atualizar EVOLUTION_API_URL automaticamente
# quando o Cloudflare Tunnel gera URL nova. Pega em https://vercel.com/account/tokens
# (escopo: o projeto geometric-forms basta).
VERCEL_TOKEN=TROCAR-token-vercel-em-https://vercel.com/account/tokens
