# =============================================================================
# Geometric Forms — variáveis de ambiente (exemplo). NÃO coloque valores reais.
# Copie para .env.local e preencha. .env.local é gitignored.
# =============================================================================

# Supabase (server-side). A SERVICE_ROLE_KEY bypassa RLS — só server, nunca client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Servidor MCP (/api/mcp) — bearer token estático de ADMIN/USO INTERNO.
# Gere um valor forte (ex.: `openssl rand -hex 32`) e mantenha em segredo.
MCP_API_TOKEN=
